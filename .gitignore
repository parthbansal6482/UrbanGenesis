# ── Data — never commit raw or processed satellite data ──────────────────────
data/raw/
data/tiles/
data/masks/
data/ndvi/
data/vegetation/
data/labels/
*.tif
*.tiff
*.jp2
*.img
*.hdf
*.nc

# ── Archives — never commit large bundles ─────────────────────────────────────
*.zip
*.tar.gz
*.gz
colab_package.zip

# ── Model weights — large binary files, never in repo ────────────────────────
model/checkpoints/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.pkl
*.joblib

# ── Demo precomputed — only the final PNGs/JSONs go in, not intermediates ────
demo/precomputed/raw/
demo/precomputed/*.tif
demo/precomputed/*.npy
demo/precomputed/*/encroachment_heatmap_*_*.png
demo/precomputed/*/mask_rgb_*_median*.png
demo/precomputed/*/true_color_202[5-9].png
demo/precomputed/*/true_color_203*.png
demo/precomputed/*/true_color_204*.png
demo/precomputed/*/true_color_205*.png
demo/precomputed/*/ndvi_map_202[5-9].png
demo/precomputed/*/ndvi_map_203*.png
demo/precomputed/*/ndvi_map_204*.png
demo/precomputed/*/ndvi_map_205*.png
demo/custom_cache/

# ── Python standard ignores ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
*.pyc
*.pyo
*.pyd

# ── Virtual environments ──────────────────────────────────────────────────────
.env
.env.local
*.env
.venv/
venv/
ENV/

# ── Secrets ───────────────────────────────────────────────────────────────────
secrets.yaml
credentials.json

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── NumPy arrays ─────────────────────────────────────────────────────────────
*.npy
*.npz

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Misc cache ────────────────────────────────────────────────────────────────
.cache/

# ── Scratch / temporary analysis scripts ─────────────────────────────────────
scratch/

# ── macOS metadata inside committed directories ───────────────────────────────
**/.DS_Store