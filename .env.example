# ---- Copernicus Data Space credentials (required for fetch_esri_landcover.py)
CDSE_USERNAME=your_copernicus_username
CDSE_PASSWORD=your_copernicus_password

# ---- Backend API server (app.py)
# Set to "true" to enable uvicorn auto-reload in development
UVICORN_RELOAD=false

# ---- CORS (app.py) — comma-separated list of allowed origins
# Defaults to localhost:3000 only if not set
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Next.js Dashboard (dashboard/)
# URL of the FastAPI backend (must be reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
